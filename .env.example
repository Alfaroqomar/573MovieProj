# MovieMatch configuration. Copy to .env and fill in. Never commit .env.

# --- Dataset (required) -------------------------------------------------------
# Absolute path to the extracted MovieLens 32M folder containing
# ratings.csv, movies.csv, tags.csv, links.csv.
# Download: https://files.grouplens.org/datasets/movielens/ml-32m.zip
MOVIELENS_DATA_PATH=

# Where processed data, trained models, and evaluation results are written.
# Defaults to ./artifacts in the repository root when empty.
MOVIEMATCH_ARTIFACTS_DIR=

# --- LLM reranking (optional) ---------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint (Ollama, ASU Voyager, a hosted
# open-weight model, ...). Leave LLM_ENABLED=false to run without reranking.
LLM_ENABLED=false
# Base URL up to and including the API version, e.g. http://localhost:11434/v1
LLM_BASE_URL=
# Leave empty for providers that do not need a key. Server-side only.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# Sends response_format={"type":"json_object"}. Set false if your provider rejects it.
LLM_JSON_MODE=true
# Use a candidate-ID JSON schema when the provider supports structured output (Ollama does).
LLM_STRUCTURED_OUTPUT=false
LLM_TEMPERATURE=0.2

# --- Posters (optional) ----------------------------------------------------------
# A URL template for a poster source you are permitted to use. Placeholders:
# {movieId}, {imdbId} (e.g. tt0114709), {tmdbId}. Empty = generated placeholders.
POSTER_URL_TEMPLATE=

# --- Backend ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Split (defaults shown) -------------------------------------------------------
# date = the proposal's split: train < 2020-01-01 <= validation < 2022-01-01 <= test
# per_user = each user's oldest 80% / next 10% / newest 10%
SPLIT_MODE=date
SPLIT_VALIDATION_START=2020-01-01
SPLIT_TEST_START=2022-01-01
SPLIT_TRAIN_FRACTION=0.8
SPLIT_VALIDATION_FRACTION=0.1
COLD_START_MAX_RATINGS=10

# --- Model settings (defaults shown) -------------------------------------------------
HIGH_RATING_THRESHOLD=4.0
TAGS_PER_MOVIE=10
POPULARITY_MIN_VOTES_QUANTILE=0.90
KNN_NEIGHBORS=50
KNN_MIN_ITEM_RATINGS=20
# sum (chosen on validation) or average (the proposal's Eq. 2)
KNN_SCORING=sum
KNN_MIN_SUPPORT=2
ALS_FACTORS=64
ALS_REGULARIZATION=0.05
ALS_ALPHA=2.0
ALS_ITERATIONS=15
ALS_RANDOM_SEED=42
ALS_EXPLICIT_FACTORS=64
ALS_EXPLICIT_REGULARIZATION=0.05
ALS_EXPLICIT_ITERATIONS=10
# Stage 1 shortlist: top N from ALS and from Item-KNN, merged into POOL_SIZE
STAGE1_PER_MODEL=30
STAGE1_POOL_SIZE=50
STAGE1_TOP_UP=true
# NeuMF (needs `pip install torch`). 0 = use every training rating.
NEUMF_EPOCHS=10
NEUMF_BATCH_SIZE=8192
NEUMF_MAX_TRAIN_RATINGS=0
NEUMF_DEVICE=auto
EVAL_SAMPLE_USERS=10000
EVAL_RANDOM_SEED=42
EVAL_COLD_START_EXTRA=5000
EVAL_BOOTSTRAP=1000
